# --- required ---
DATABASE_URL=postgres://korugan:CHANGE_ME@127.0.0.1:5432/korugan?sslmode=disable

# --- http ---
KORUGAN_ADDR=:8080
# Bearer token protecting /api/* (strongly recommended outside localhost)
KORUGAN_API_TOKEN=

# --- connectors (read-only scopes are enough for v0.1) ---
CLOUDFLARE_API_TOKEN=

# --- BYOK LLM (optional; leave empty for zero-key mode) ---
# provider: openrouter | openai | deepseek | ollama | anthropic
KORUGAN_LLM_PROVIDER=
KORUGAN_LLM_MODEL=
KORUGAN_LLM_API_KEY=
# optional override for self-hosted gateways
KORUGAN_LLM_BASE_URL=
# price table (USD per 1k tokens) — enables real cost accounting + budgets
KORUGAN_LLM_PRICE_IN_PER_1K=
KORUGAN_LLM_PRICE_OUT_PER_1K=
# spend caps (USD); 0/empty = unlimited. Chat keeps a 10% reserved slice.
KORUGAN_LLM_BUDGET_DAILY_USD=
KORUGAN_LLM_BUDGET_MONTHLY_USD=

# --- secrets at rest (base64 of 32 random bytes) ---
# Enables the Settings screen: store Cloudflare/LLM credentials sealed in the
# database instead of here. Without it, credentials come from env only.
# Generate: openssl rand -base64 32   (then keep it safe; losing it orphans secrets)
KORUGAN_MASTER_KEY=

# --- tuning ---
KORUGAN_LOG_LEVEL=info
KORUGAN_POLL_INTERVAL_SECONDS=300
